__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# FreeCiv run artifacts are regenerated; keep committed sample runs but ignore fresh ones.
benchmarks/freeciv/ab_runs/tmp_*/
benchmarks/freeciv/viz/data/
benchmarks/freeciv/viz/dist/
benchmarks/freeciv/viz/node_modules/

# Batch/live-run RAW artifacts are large and regenerable; only the aggregate/comparison summaries
# (aggregate.{md,json}, comparison.{md,json}, manifest.json) are meant to be committed as evidence.
benchmarks/freeciv/ab_runs/**/*.jsonl
benchmarks/freeciv/ab_runs/**/*.heartbeat
benchmarks/freeciv/ab_runs/**/traces/
benchmarks/freeciv/ab_runs/**/atomspace_*.json

# Colleague's atomspace-v2 under evaluation: bundles GPL freeciv ruleset data
# ("do not vendor into the MIT repo" per its README). Kept local, never committed.
benchmarks/freeciv/v2_scratch/

# local provider secrets (never commit)
.env
